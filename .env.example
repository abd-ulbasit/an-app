# Local docker compose settings. Copy to .env (which is gitignored):
#   cp .env.example .env
# and set a password, for example with: openssl rand -base64 24
#
# Postgres only applies POSTGRES_PASSWORD when it first initialises the
# db_data volume. If you already have that volume, either keep using the
# password it was created with or reset it with `docker compose down -v`
# (this deletes local guestbook data).
POSTGRES_DB=guestbook
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
