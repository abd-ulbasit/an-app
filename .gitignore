# Project learning summary doc
PROJECT_LEARNING_SUMMARY.md

# Terraform: state can hold secrets and must never be committed, in any
# directory. The dependency lock file (.terraform.lock.hcl) IS committed.
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
*.tfplan

# Local secrets. Copy .env.example to .env and fill it in.
.env
.env.*
!.env.example

# Real Kubernetes Secret manifests. Create db-secret with
# `kubectl create secret` (see k8s/setup.md); never commit it.
k8s/db-secret.yaml
k8s/*secret*.yaml

# Node
node_modules/
npm-debug.log*
frontend/build/
